# Django backend — required environment.
#
# A TEMPLATE. Every value below is a placeholder describing the shape of the
# setting, never a real one. Copy to backend/.env (git-ignored) and fill in
# from your own secret store. Nothing in this file is a working credential.
#
# config/settings/production.py raises ImproperlyConfigured when any of the
# first three is missing, so a misconfigured deploy refuses to boot instead of
# starting with a guessed value.

# Which settings module to load. Production MUST set this explicitly.
DJANGO_SETTINGS_MODULE=config.settings.production

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# This is the same database the Next.js side reaches through DATABASE_URL.
# Never commit a filled-in value.
DJANGO_DATABASE_URL=

# Comma-separated hostnames this backend answers on.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins allowed to submit state-changing requests, scheme
# included. Needed only when the admin UI is served from a different host.
#   e.g. https://aly.lat
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where Django's own admin is mounted. Moving it off the default /admin/ path
# is cheap and removes the whole class of drive-by scans for it.
DJANGO_ADMIN_PATH=django-admin
