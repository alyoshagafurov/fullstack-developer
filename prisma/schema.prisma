// Aly Portfolio 3.0 — "Студийная витрина"
//
// This schema shares a Neon database with the previous version of the site.
// Every model below maps to a table name that did NOT exist before
// (the old build owned "Project" and "ProjectLead"), so `prisma db push`
// only ever CREATES tables here and never rewrites the owner's live leads.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema. Migrations and
// introspection read it from prisma.config.ts; the runtime gets it through the
// Neon driver adapter in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

/// A project request submitted from the site or, later, from the bot.
model Lead {
  id  String @id @default(cuid())
  /// Human-readable number shown to the client: ALY-2026-014
  ref String @unique

  name        String
  email       String
  company     String?
  /// Telegram / WhatsApp / phone — whatever the client prefers.
  contact     String?
  projectType String
  budget      String
  timeline    String
  goal        String
  description String
  audience    String?
  features    String?
  links       String?
  extra       String?

  status LeadStatus @default(NEW)
  /// "site" | "telegram" — where the request came from.
  source String     @default("site")

  /// Set the first time the owner moves the lead out of NEW.
  firstRepliedAt DateTime?

  /// The agreed value of the deal, once there is one. Money is never a float:
  /// a rounding error here is a rounding error in the owner's income.
  dealAmount   Decimal? @db.Decimal(12, 2)
  /// Stored beside the amount, not in a setting. The owner works in сомони,
  /// rubles and dollars, and a sum only means something with its currency.
  dealCurrency String?

  payments Payment[]
  expenses Expense[]
  notes    Note[]
  events   StatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("aly_lead")
}

/// Money actually received, or expected by a date. Income is counted when it
/// arrives, which is how the owner said he counts it (answer 13.5).
model Payment {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  amount   Decimal     @db.Decimal(12, 2)
  currency String
  kind     PaymentKind @default(STAGE)

  /// Null until the money is in. That is what makes it income.
  paidAt DateTime?
  /// Null when nothing was promised for a date. A past dueAt with no paidAt is
  /// what the finance screen calls a debt.
  dueAt  DateTime?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([paidAt])
  @@map("aly_payment")
}

enum PaymentKind {
  PREPAYMENT
  STAGE
  FINAL
  SUPPORT

  @@map("aly_payment_kind")
}

/// A cost. Categories are the eleven the owner listed in answer 13.4 and live
/// in lib/content/finance.ts, not in a table: they are his list, not data.
model Expense {
  id       String  @id @default(cuid())
  title    String
  amount   Decimal @db.Decimal(12, 2)
  currency String
  category String

  spentAt DateTime
  note    String?

  /// Set when the cost belongs to one project rather than to the business.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentAt])
  @@index([category])
  @@map("aly_expense")
}

/// The owner's private note on a lead. Never leaves the admin: no public route
/// selects it, and it is never sent to a client through the bot.
model Note {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("aly_note")
}

/// Every status change, so the lead has a history rather than just a state.
model StatusEvent {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  from LeadStatus?
  to   LeadStatus

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("aly_status_event")
}

/// Mapped to its own Postgres type. The database already carries a `LeadStatus`
/// enum belonging to the previous build; sharing that name would make this
/// schema alter a type the old application still depends on.
enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  DECLINED
  CANCELLED

  @@map("aly_lead_status")
}

/// A published case study. The owner fills these in from the admin.
model Case {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  client String?
  year   String

  task     String
  solution String
  result   String

  technologies String[]
  liveUrl      String?

  /// File under /public/objects — the object shown in the vitrine.
  objectImage String   @default("/objects/laptop.webp")
  /// Word set huge and faint behind the object.
  ghostWord   String?
  /// Real screenshots of the work. The only colour on the whole site.
  screenshots String[]

  featured  Boolean @default(false)
  order     Int     @default(0)
  published Boolean @default(false)

  testimonial Testimonial?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("aly_case")
}

/// A client testimonial. Never generated, never invented — owner-entered only.
model Testimonial {
  id      String  @id @default(cuid())
  name    String
  company String?
  role    String?
  text    String

  /// Real client photo or company logo. Empty means a drawn monogram.
  avatarUrl String?

  /// Testimonials belong to the case they are about, when there is one.
  caseId String? @unique
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  featured  Boolean @default(false)
  order     Int     @default(0)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("aly_testimonial")
}

/// The single owner account for the admin. Passwords are bcrypt hashes.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("aly_admin_user")
}
