// Project Brief — persistence.
//
// One model for now. The brief the site collects (lib/brief/schema.ts) maps
// field-for-field onto ProjectLead, plus the columns an operator needs: a
// quotable reference, a pipeline status, and the idempotency key that stops a
// retried request from creating a second row.
//
// The connection string is read from the environment only — never committed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A case study, written by the owner in the admin and rendered on /work.
///
/// Separate from ProjectLead on purpose: a lead is something a stranger sent
/// in and is a record that must not be edited, while a case is the owner's own
/// published writing. They share a database and nothing else.
///
/// Screenshots are Vercel Blob URLs rather than bytes. A case carries four or
/// five images; storing them here would put megabytes into a row the register
/// has to read, and every /work render would pay for it.
model Project {
  id String @id @default(cuid())

  /// URL segment — /work/<slug>. Stable once published, because changing it
  /// breaks every link anyone has shared.
  slug String @unique

  title String
  /// One line under the title in the register.
  summary String @default("")
  /// The body, plain text; blank lines become paragraphs when rendered.
  description String @default("")
  /// Stack labels in display order — "Next.js", "PostgreSQL", "Django".
  technologies String[] @default([])
  /// The live site, when there still is one.
  liveUrl String @default("")
  /// Blob URLs in display order. The first is the cover.
  screenshots String[] @default([])
  year        String   @default("")

  /// Nothing reaches /work until the owner says so, so a half-written case is
  /// never one refresh away from being public.
  published Boolean @default(false)
  /// Manual ordering on /work; ties break by createdAt.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The only query /work makes: published cases, in order.
  @@index([published, position])
}

/// Pipeline state. Deliberately small — the admin panel is a later phase.
enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model ProjectLead {
  id String @id @default(cuid())

  /// Server-issued, human-quotable: ALY-2026-4F7K2. Shown to the client.
  reference String @unique

  /// Client-generated once per completed brief. A retry reuses it, so the
  /// unique constraint turns a duplicate POST into a lookup rather than a
  /// second lead.
  submissionId String @unique

  // ── The brief itself ──────────────────────────────────────────────────
  projectType      String
  projectTypeOther String @default("")
  goal             String
  description      String
  functionality    String @default("")
  existingUrl      String @default("")
  referenceLinks   String @default("")
  notes            String @default("")
  budget           String
  timeline         String

  // ── Contact ───────────────────────────────────────────────────────────
  name     String
  company  String @default("")
  email    String
  telegram String @default("")
  whatsapp String @default("")

  /// The visitor agreed to be contacted about this brief. Stored as proof.
  consent Boolean @default(true)

  // ── Provenance ────────────────────────────────────────────────────────
  /// UI language the brief was filled in — useful when replying.
  locale String @default("ru")
  /// Client clock, from the brief's own meta.
  startedAt   DateTime
  completedAt DateTime
  /// Server clock. The one to trust.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Operator fields (admin panel, later phase) ────────────────────────
  status LeadStatus @default(NEW)
  /// Private note for the owner. Never returned by the public API.
  internalNote String @default("")

  // Indexes the admin panel will actually query on: the pipeline board
  // (status + newest first), the inbox (newest first), and lookup by client.
  // `reference` and `submissionId` are already indexed by @unique.
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}
